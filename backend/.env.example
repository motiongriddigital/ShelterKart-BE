# ---- AI engines: research needs at least one key that can search (Anthropic, OpenAI, Gemini or xAI) ----
ANTHROPIC_API_KEY=            # one of five AI engines (see "AI engines" below); any engine with a key competes on cost
ANTHROPIC_MODEL=               # optional; the catalogue default is claude-sonnet-5-5
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305   # change here, not in code, when a new version ships
ANTHROPIC_RETRY_WAIT_MS=1000      # a failed Claude call (network error, 429, 5xx, 529) is retried ONCE after this wait, or the server's Retry-After, never more than 5 seconds; a client error (400, 401, 403) is never retried

# AI engines (backend/engines): vendor-neutral. Five engines on equal terms: Anthropic (Claude), OpenAI (ChatGPT models),
# Google (Gemini), xAI (Grok), DeepSeek. An engine takes part once its API key is set. For each agent (research, adviser,
# documents, translate, verify) the router ranks the engines that can do the job by expected cost per call, cheapest first,
# the rest as fail-over. Run the quality gate before going live: node tools/engine_benchmark.js --engine all
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=                   # processed in China and trains on API data by default (as reported): text-only jobs, if allowed at all
# Models: each engine has a default in backend/data/ai-engines.json; override per engine or per agent, e.g. a cheaper model for light jobs.
OPENAI_MODEL=                       # e.g. gpt-5.4-mini
GEMINI_MODEL=                       # e.g. gemini-3.5-flash
XAI_MODEL=                          # e.g. grok-4.3
DEEPSEEK_MODEL=                     # e.g. deepseek-v4-flash
ANTHROPIC_MODEL_ADVISER=            # example per-agent override: claude-haiku-5-5 for the adviser
# Company rules
AI_ENGINES=                         # optional allow-list for every agent, e.g. anthropic,openai,gemini,xai (leave out an engine to ban it)
AI_ENGINES_RESEARCH=                # optional allow-list for one agent
AI_ROUTING=cost                     # cost: cheapest qualified engine first. order: use the allow-list's own order
AI_PERSONAL_DATA_ENGINES=           # engines your lawyer approved to read buyers' uploaded documents. EMPTY = the document check is off.
                                    # The privacy policy currently names Anthropic as the only AI processor.
AI_REQUIRE_BENCHMARK=true           # once quality-gate results exist for an agent, only engines that passed may serve it
XAI_BASE_URL=                       # optional regional endpoints
XAI_X_SEARCH=false                  # true: Grok also searches posts on X in the "what buyers say" pass

# ---- Spike protection: the daily cap, per-connection limit, bot protection and pause switches are under "Safety switches" at the end of this file ----

# ---- Registry lane. France, Norway, Singapore, Finland and Czech Republic need no key. ----
COMPANIES_HOUSE_API_KEY=      # UK, free: developer.company-information.service.gov.uk
SEC_USER_AGENT=              # US, SEC EDGAR needs a declared identity, format "Company name contact@your-domain"; unset = the US register is not queried
ABR_GUID=                     # Australia, free: abr.business.gov.au/Tools/WebServices (arrives by email)
GCIS_NOTIFIED=                # Taiwan: set to true ONLY after filing the ministry's usage notification (opendata.gcis@gmail.com)

# ---- Security: REQUIRED in production ----
NODE_ENV=production
ALLOWED_ORIGINS=https://shelterkart.com   # your frontend's exact origin; comma-separate several
TRUST_PROXY=1   # how many proxies sit in front of this API (a hop count), or their addresses (e.g. 10.0.0.0/8). Unset = none: the connecting address is the client. `loopback` for a proxy on this machine (covers 127.0.0.1 and ::1). Never "true".

# ---- Request validation against docs/api/openapi.yaml (SHEL-64). Responses and security are not checked. ----
API_VALIDATION=off                  # off | report | enforce. report: mismatches are counted (GET /api/admin/contract) and logged, nothing is refused. enforce: 400 { ok:false, code:'invalid_request', error, fields:[{path,message}] } for the prefixes below
API_VALIDATION_ENFORCE=             # comma list of path prefixes enforced when API_VALIDATION=enforce, e.g. /api/auth,/api/me; every other path stays report-only

# ---- HTTP caching and request timing (SHEL-64) ----
HTTP_CACHE=off                      # on: public data (the market list) gets Cache-Control public, max-age=300, stale-while-revalidate=60; admin, me and auth get no-store unless the route sets its own
SLOW_MS=1000                        # a request slower than this logs one line "[slow] METHOD /route/:pattern status ms"; 0 = no line. The table is GET /api/admin/timing

# ---- Named responsibility, shown on every brief ----
RESPONSIBLE_NAME=Preeyancc      # the name printed on the legal pages; add the surname here if you want it shown
RESPONSIBLE_TITLE=Founder, ShelterKart
CORRECTIONS_EMAIL=corrections@shelterkart.com

# ---- Selling reports. Leave PAYMENTS_ENABLED unset and every brief is free and complete. ----
PAYMENTS_ENABLED=              # "true" only once your payment provider is connected
ACCESS_TOKEN_SECRET=           # long random string: openssl rand -hex 32
# Pricing and payments (pricing/, payments/; the reviewed price book is backend/data/price-book.json)
# The fee is set by the PROPERTY and the evidence depth, the same in dollars for every buyer; the buyer's country sets
# only the currency, tax and payment route. Prices change only by releasing a new price book: node tools/build_price_book.js
# A country SELLS only when its tax profile is complete (backend/data/tax-profiles.json). With nothing set below, nothing sells.
GSTIN=                         # your GSTIN: turns India on (GST 18% included in INR prices)
RAZORPAY_INTERNATIONAL=false   # true once Razorpay has activated international payments: turns on every country below its tax threshold
UK_VAT_NO=                     # UK VAT number: turns the UK on (registration is required from the first sale)
EU_OSS_VAT_NO=                 # EU non-Union OSS number: turns all 24 EU countries on
TAX_PROFILES=                  # JSON overrides of tax profiles, after your tax adviser confirms a rule, e.g. {"AE":{"mode":"not_required_yet","thresholds":[{"amount":375000,"currency":"AED","basis":"country"}],"thresholdMode":"any"}}
RAZORPAY_CURRENCIES=           # optional comma list of currencies Razorpay confirmed in writing; others are quoted in USD
QUOTE_SECRET=                  # optional: signs quotes (defaults to ACCESS_TOKEN_SECRET)
LUT_NO=                        # Letter of Undertaking number, printed on export invoices
BUSINESS_LEGAL_NAME=           # printed on invoices
BUSINESS_ADDRESS=              # printed on invoices
SUPPLIER_STATE=                # your state, for the GST invoice
GST_SAC=                       # the service's accounting code for GST invoices (your CA confirms)
TRANSLATE_ENABLED=true         # false = every report in English (the page says so)
TRANSLATE_VERIFY=true          # independent meaning check for negative, legal and financial claims; false skips it (not advised)
TRANSLATE_MODEL=               # optional: a different model for translation; defaults to ANTHROPIC_MODEL
TRANSLATE_DAILY_CAP=4000       # translation calls per day; beyond it, untranslated sentences show in English
RAZORPAY_KEY_ID=               # Razorpay Dashboard > Account & Settings > API Keys (rzp_test_... first)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=       # the secret you type when creating the webhook; not the key secret
PAYMENT_WEBHOOK_SECRET=        # only for a non-Razorpay provider; leave empty otherwise
PAYMENT_EVENT_RETRY_SECONDS=20   # a payment webhook received but never finished is processed again when the provider redelivers it, after this many seconds; a finished one is never repeated

# ---- Needed for payments, OTP, disputes and admin (not for research itself) ----
DATABASE_URL=                 # REQUIRED in production: without it, reports vanish on every restart, including ones buyers paid for
ADMIN_USERNAME=
ADMIN_PASSWORD=
PORT=4000

# ---- Source health: a nightly check that each official register still works and still permits automated access ----
ALERT_WEBHOOK_URL=             # Slack or Discord incoming-webhook URL: told when a register is switched off, or comes back
SOURCE_HEALTH_SCHEDULE=        # set to "true" on exactly ONE server instance to run the check in-process; or use cron and `npm run health`
SOURCE_HEALTH_HOURS=24
HEALTH_ROBOTS_OVERRIDE=        # e.g. "sg,fr": keep these registers running although robots.txt disallows the path. Only after
                               # confirming the register's own terms permit automated API use; the alert message tells you when to consider it

# ---- Research depth: three focused passes run in parallel per NEW report (cached/matched searches cost nothing) ----
SEARCH_FACETS=record,track,voice   # official record + developer's own site; track record + timeline; what buyers say (reviews, YouTube, social)
SEARCH_USES_PER_PASS=8             # web searches allowed per pass

# ---- Safety switches (blind-spot review, October 2026) ----
RESEARCH_PAUSED=false               # true: stop ALL new research at once; already-researched reports still open
RESEARCH_MARKETS_OFF=               # stop new research in these markets only, e.g. tw,cz
RESEARCH_DAILY_CAP=1500             # new researches a day; 0 now means PAUSED (it used to be read as 1,500). Alerts at 50%, 80%, 100% go to ALERT_WEBHOOK_URL
RESEARCH_HOURLY_PER_IP=10           # new researches per connection per hour. Mobile networks share addresses, so raise it only if real users are blocked
# Recommended at launch: in,us (India, and the US pilot, where adverse findings carry the most legal risk; see the US study).
ADVERSE_HOLD_MARKETS=               # e.g. in,us or all: negative findings wait for a person in the admin dashboard; the score is held and the report cannot be unlocked until released
BOT_GUARD=                          # on|off. Default: on in production. Before a NEW research the browser solves a short proof of work (no third party, no cookie, nothing stored about the visitor); already-researched reports never need it
BOT_POW_BITS=16                     # puzzle difficulty; +1 automatically at 50% of the day's research allowance, +2 at 80%
BOT_SECRET=                         # signs the puzzles; falls back to QUOTE_SECRET, then ACCESS_TOKEN_SECRET

# --- The investigator and the questions-first report (buyer flow: /start, /r/:ref) ---
# New investigations a day (0 pauses them). Each free preview runs the panel's first sweep; the paid report continues it.
INVESTIGATE_DAILY_CAP=100
# Engines in the free preview's sweep (the paid stage uses the whole panel).
INVESTIGATE_PREVIEW_PANEL=2
# Investigations running at once (admin pilot); the buyer flow allows twice this.
INVESTIGATE_CONCURRENCY=2
# Engines on the panel (empty = every engine that is set up and allowed).
INVESTIGATE_PANEL_SIZE=
# The statutory delay-interest rate in force, used to price a delay (India: SBI highest MCLR + 2%).
DELAY_RATE_PCT=
# Claude reads whole pages during research (set to off to disable); a newer tool version can be named here.
ANTHROPIC_WEB_FETCH=on
ANTHROPIC_WEB_FETCH_TOOL=web_fetch_20250910
# Only if your account still needs the beta header for web fetch.
ANTHROPIC_WEB_FETCH_BETA=

# --- Delivering reports (engine/delivery.js) ---
# The public address used in links sent to buyers, for example https://shelterkart.com
PUBLIC_BASE_URL=
# E-mail: Resend or Postmark, and the sender address.
DELIVERY_EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
DELIVERY_FROM=
# WhatsApp Cloud API (Meta). A business message needs an approved template whose body takes two parameters: project, link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---- Money and scale (investigations) ----------------------------------------------------------------------------
# The free preview is shallow by design: one engine, 6 searches, 2 page reads. The paid report goes deep.
INVESTIGATE_PREVIEW_PANEL=1
PREVIEW_SEARCHES=6
PREVIEW_FETCHES=2
# A paid report's AI spend stops at this share of its net price (0.30 = 30%).
AI_CAP_SHARE=0.30
# Warn when today's AI spend passes this (US$); pause NEW free previews when it passes the second. Paid reports continue.
AI_DAILY_ALERT_USD=
AI_DAILY_MAX_USD=
# New investigations a day: overall, and per market (default 40% of the overall cap, at least 5).
INVESTIGATE_DAILY_CAP=100
INVESTIGATE_MARKET_DAILY_CAP=
# Saved investigations (survive restarts; one server instance). PDFs printed at once.
LIVE_JOBS_DIR=
PDF_CONCURRENCY=2

# Pricing book storage: set to pg to keep the price book in the database (requires DATABASE_URL). Leave empty for the file.
PRICING_STORE=

# --- Merchant of Record (Dodo Payments): sells outside India; the merchant is the seller of record and collects the buyer's tax ---
# Serves a country only when BOTH keys are set AND the currency has a product (see data/mor-products.json). Never serves India.
DODO_API_KEY=                   # Dodo Dashboard > Developer > API Keys (test key first)
DODO_WEBHOOK_KEY=               # Dodo Dashboard > Developer > Webhooks > your endpoint > signing secret (starts whsec_)
DODO_MODE=test                  # test | live. DODO_BASE_URL overrides the address (default test.dodopayments.com / live.dodopayments.com)
MOR_PRODUCTS=                   # optional JSON, e.g. {"USD":"pdt_...","GBP":"pdt_..."} overrides data/mor-products.json
# The webhook endpoint to register in Dodo: https://YOUR-DOMAIN/api/payments/mor/webhook  (events: payment.succeeded, payment.failed, refund.*)
# PUBLIC_BASE_URL (above) is required: the buyer returns to it after paying.

# ---- The marketing desk (backend/social). OFF by default; see SOCIAL_ENGINE.md before switching anything on. ----
# SOCIAL_ENGINE=on                      # the desk's routes, its minute loop and its daily routine
# SOCIAL_PUBLISH=live                   # unset = dry run: posts are recorded, never sent. The safe default.
# SOCIAL_DATA_DIR=/var/lib/shelterkart-social   # files, when there is no DATABASE_URL. With neither, the engine refuses to start.
# SOCIAL_ALLOW_MEMORY=true              # a demo only: everything is lost on restart
# SOCIAL_EPOCH_MONDAY=2026-11-02        # week 0 of the 12-week curriculum (set once; stored)
# SOCIAL_LANG_READY=hi,ar,fr,es,de,pl,ja,zh-Hant   # languages whose landing page exists and whose native check passed; the rest post in English
# SOCIAL_APPROVAL_PIN=                  # required to approve a pack
# SOCIAL_AUTOPLAN=on                    # plan the next two weeks daily, and build and announce the pack on SOCIAL_PACK_WEEKDAY (0=Sun ... 4=Thu)
# SOCIAL_PROTECTED_NAMES=               # developer names that must never appear in a post (comma separated)
# SOCIAL_CANARY=off                     # NOT recommended: the known-bad post in every pack is what shows approvals are still being read
# SOCIAL_MEDIA_DIR=                     # where rendered cards are kept; must survive restarts (default: SOCIAL_DATA_DIR/media)
# AYRSHARE_API_KEY=  AYRSHARE_PROFILE_KEY=   # the publishing service (X, Facebook, Instagram, LinkedIn, YouTube, TikTok, Threads)
# TELEGRAM_BOT_TOKEN=  TELEGRAM_CHANNEL_ID=  # the public Telegram channel the desk posts to
# TELEGRAM_APPROVER_CHAT_ID=  TELEGRAM_APPROVER_USER_ID=  TELEGRAM_WEBHOOK_SECRET=   # the founder's alerts, digest, veto and pause
# LINE_CHANNEL_TOKEN=                   # the LINE Official Account (broadcast messages)
# PUBLIC_BASE_URL=https://shelterkart.com    # the public address of rendered cards, and the desk link in alerts
# SOCIAL_KEEPER_AUTOVERIFY=on           # the keeper's items become usable without a person ONLY if the writer (adviser) and checker (verify) run on DIFFERENT providers
# SOCIAL_KEEPER_RECHECK=on              # daily: re-read the official page of any item expiring within 21 days; renew it, or expire it if the supporting words are gone

# Keeping the visit's source (campaign link or referring site) on the visitor's device needs an explicit yes in the EEA, the UK and Switzerland.
#   eu   (default) ask visitors in those countries, and any visitor whose country the hosting edge cannot tell
#   all  ask everywhere
#   none never ask (notice only): only if counsel advises this note needs no consent
SK_SOURCE_CONSENT=eu

# The new search (backend/search): candidates before research, matched however the buyer typed.
#   shadow (default) runs silently beside the old search; read GET /api/admin/search/shadow before switching on
#   on     the page shows up to five candidates and researches only the one the buyer confirms (needs the founder's approval of the screen)
#   off    neither runs
SEARCH_V2=shadow
# Where the search index is saved (falls back to SOCIAL_DATA_DIR; without either it lives in memory and regrows from research)
SEARCH_DATA_DIR=

# ---- User accounts (backend/accounts). OFF by default; see docs/accounts/TDD.md before switching on. ----
# ACCOUNTS_ENABLED=on                   # sign-in by e-mail code, cookie sessions; guarded routes then answer 401 without a session
# EDGE_COUNTRY_HEADER=cf-ipcountry       # the header your edge network sets with the visitor's two-letter country; read once at a user's first sign-in, never guessed from the IP address
# AUTH_PEPPER=                          # required when on: a random secret of at least 32 characters (keys the code hashes)
# ACCOUNTS_SEARCH_GATE=view             # view = a search may start unsigned and the wall is on the results; start = sign in before the search starts
# SESSION_DAYS=30                       # sliding session length
# SESSION_MAX_DAYS=90                   # absolute limit
# AUTH_CODE_MINUTES=10                  # how long a code works
# AUTH_CODE_ATTEMPTS=5                  # wrong tries per code
# TERMS_VERSION=2026-11                 # stored on the user at first sign-in
# PRIVACY_VERSION=2026-11
# ACCOUNTS_COOKIE_SECURE=               # true forces the Secure flag and the __Host- cookie name (always on when NODE_ENV=production)
# ACCOUNTS_CSRF=report                 # off | report | on: a state-changing call that carries the session cookie must come from ALLOWED_ORIGINS or the API's own origin; report only logs, on answers 403 csrf
# ACCOUNTS_ALLOW_MEMORY=                # development and tests only: accounts without DATABASE_URL, lost on restart
# ACCOUNTS_DEV_ECHO=                    # development and tests only: the code is returned in the reply. The server refuses to start with it in production.

# ---- Encrypted database backups (backend/engine/backups.js; docs/admin/BACKUPS-DESIGN.md). OFF until a key is set. ----
# BACKUP_KEY_ID=k1                      # which key encrypts new backups
# BACKUP_KEY_k1=                        # 64 hex characters: openssl rand -hex 32. Keep a copy OFF this server; without it a backup cannot be opened. Old keys stay as BACKUP_KEY_<id> so old files still open.
# BACKUP_DIR=/var/backups/shelterkart   # where the encrypted files go; use a mounted volume or a folder synced off the host
# BACKUP_EVERY_DAYS=14                  # 1 to 90
# BACKUP_KEEP=6                         # newest good files kept
