# ShelterKart: settings for the FIRST LIVE RUN of the investigator.
# Three properties (Mumbai, London, Dubai), live AI engines, no payments, no messages to anyone.
#
#   1. Copy this file to backend/.env.first-run and paste in the five API keys below.
#   2. node tools/first_live_run.js --check     free: shows which engines will take part, and with which models
#   3. node tools/first_live_run.js --dry       free: runs the whole pipeline on stand-in data, writes sample files
#   4. node tools/first_live_run.js             the live run (stops itself at FIRST_RUN_MAX_USD)
#
# Results land in tools/samples/live/: a report, a preview and a PDF per property, and summary.md with the
# counts, the time taken, the estimated cost per property, and the Celeste pass-or-fail test.

# ---- The five engines: paste each vendor's API key -----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Which engines may take part. DeepSeek cannot search the web, so it only reviews and writes questions.
# Its data is processed in China: delete it from this list if the company has not approved that.
AI_ENGINES=anthropic,openai,gemini,xai,deepseek

# The reviewer and the question writer shape every report, so for this run they are the strongest engines, in this
# order, rather than the cheapest first. (The research panel runs every engine above at once, so order does not matter.)
AI_ROUTING=order
AI_ENGINES_VERIFY=anthropic,openai,deepseek

# No benchmark results exist yet. This run is the benchmark, so an empty quality gate must not exclude engines.
AI_REQUIRE_BENCHMARK=false

# ---- Models: the strongest in our catalogue, because this run sets the quality bar ----------------------------
# The defaults are the cheaper models. After this run, delete these lines and run again to compare quality and cost.
# Only Anthropic's model names and prices in our catalogue were checked against official documentation (7 October);
# confirm the others with each vendor before the run.
ANTHROPIC_MODEL_RESEARCH=claude-opus-5-5
OPENAI_MODEL_RESEARCH=gpt-5.5
GEMINI_MODEL_RESEARCH=gemini-3.1-pro-preview
XAI_MODEL_RESEARCH=grok-4.5
# The reviewer and the question writer
ANTHROPIC_MODEL_VERIFY=claude-opus-5-5
OPENAI_MODEL_VERIFY=gpt-5.5
DEEPSEEK_MODEL_VERIFY=deepseek-v4-pro

# ---- Research behaviour ---------------------------------------------------------------------------------------
# Claude reads whole pages and PDFs (web fetch, tool version checked against Anthropic's documentation).
ANTHROPIC_WEB_FETCH=on
ANTHROPIC_WEB_FETCH_TOOL=web_fetch_20250910
# Only if your Anthropic account still asks for the web-fetch beta header; normally leave empty.
ANTHROPIC_WEB_FETCH_BETA=
# Every engine that can search takes part in the first sweep (empty = all of them).
INVESTIGATE_PANEL_SIZE=

# Delay interest under RERA Rule 18 (Maharashtra): State Bank of India's highest MCLR plus 2%.
# Last seen: SBI three-year MCLR 8.80%, effective July 2026 (BankBazaar). Confirm on sbi.co.in on the day of the run.
DELAY_RATE_PCT=10.80

# ---- The spending stop ----------------------------------------------------------------------------------------
# US dollars for the whole run, all three properties, as estimated from the catalogue prices by the engine meter.
# The run starts no new round, review or property once the estimate passes this.
FIRST_RUN_MAX_USD=75
# How deep each investigation goes in this run: rounds of lead-following, leads per round, minutes per property.
FIRST_RUN_ROUNDS=3
FIRST_RUN_LEADS_PER_ROUND=5
FIRST_RUN_MINUTES=20
