{
  "_about": "The ShelterKart brand system. The single source for every surface: the website, the reports and their PDFs, the guide, the sales-office card, the share image and the investor deck. Change a value here and rebuild; never set a colour or a font in a surface directly.",
  "name": "ShelterKart",
  "tagline": "Peace of mind, on the record.",
  "domain": "shelterkart.com",
  "colors": {
    "paper": {
      "hex": "#FAF8F5",
      "use": "the page"
    },
    "white": {
      "hex": "#FFFFFF",
      "use": "cards on paper"
    },
    "ink": {
      "hex": "#0A1C33",
      "use": "headings and strong text"
    },
    "inkSoft": {
      "hex": "#2F4460",
      "use": "body text"
    },
    "slate": {
      "hex": "#52657F",
      "use": "secondary text, captions"
    },
    "rule": {
      "hex": "#E4DDD1",
      "use": "hairlines and borders"
    },
    "navy": {
      "hex": "#061428",
      "use": "masthead, price block, dark surfaces"
    },
    "cream": {
      "hex": "#F5E6C2",
      "use": "text on navy"
    },
    "gold": {
      "hex": "#D3A245",
      "use": "the one primary button per screen, the icon's fold, large numerals and borders; never small text on paper"
    },
    "goldDark": {
      "hex": "#8A6321",
      "use": "small labels and kickers on paper"
    },
    "tint": {
      "hex": "#FBF3DE",
      "use": "formula and summary boxes"
    },
    "cool": {
      "hex": "#F1F4F9",
      "use": "worked examples"
    },
    "verified": {
      "hex": "#1D6338",
      "use": "status: verified from an official record"
    },
    "reported": {
      "hex": "#7A5200",
      "use": "status: reported by a non-official source"
    },
    "inference": {
      "hex": "#2A5A8C",
      "use": "status: inference drawn from facts"
    },
    "disputed": {
      "hex": "#8A3A2E",
      "use": "status: sources disagree"
    },
    "notOnRecord": {
      "hex": "#52657F",
      "use": "status: not on the public record, ask"
    },
    "verifiedBg": {
      "hex": "#E3F0E8",
      "use": "background of a verified status label"
    },
    "reportedBg": {
      "hex": "#F6ECD6",
      "use": "background of a reported status label"
    },
    "inferenceBg": {
      "hex": "#E4EBF4",
      "use": "background of an inference status label"
    },
    "disputedBg": {
      "hex": "#F7E3DF",
      "use": "background of a disputed status label"
    },
    "notOnRecordBg": {
      "hex": "#ECEEF1",
      "use": "background of a not-on-record status label"
    }
  },
  "contrast": [
    [
      "ink",
      "paper"
    ],
    [
      "inkSoft",
      "paper"
    ],
    [
      "slate",
      "paper"
    ],
    [
      "goldDark",
      "paper"
    ],
    [
      "ink",
      "tint"
    ],
    [
      "ink",
      "white"
    ],
    [
      "cream",
      "navy"
    ],
    [
      "navy",
      "gold"
    ],
    [
      "verified",
      "paper"
    ],
    [
      "reported",
      "paper"
    ],
    [
      "inference",
      "paper"
    ],
    [
      "disputed",
      "paper"
    ],
    [
      "notOnRecord",
      "paper"
    ],
    [
      "verified",
      "white"
    ],
    [
      "reported",
      "white"
    ],
    [
      "inference",
      "white"
    ],
    [
      "disputed",
      "white"
    ],
    [
      "verified",
      "verifiedBg"
    ],
    [
      "reported",
      "reportedBg"
    ],
    [
      "inference",
      "inferenceBg"
    ],
    [
      "disputed",
      "disputedBg"
    ],
    [
      "notOnRecord",
      "notOnRecordBg"
    ]
  ],
  "fonts": {
    "display": {
      "family": "Fraunces",
      "weight": 600,
      "file": "fonts/fraunces-latin-600-normal.woff2",
      "format": "woff2",
      "use": "headings, numerals, the wordmark, the founder's words"
    },
    "text": {
      "family": "Instrument Sans",
      "files": {
        "400": "fonts/InstrumentSans-Regular.ttf",
        "700": "fonts/InstrumentSans-Bold.ttf"
      },
      "format": "truetype",
      "use": "all reading text, labels and buttons; numbers set with tabular figures"
    },
    "textFallback": "'Noto Sans','Noto Sans Devanagari','Noto Sans Arabic','Noto Sans JP','Noto Sans TC',system-ui,-apple-system,'Segoe UI',Arial,sans-serif",
    "displayFallback": "Georgia,'Times New Roman',serif"
  },
  "type": {
    "webBase": 16,
    "webBaseLarge": 18,
    "printBasePt": 10,
    "ratio": 1.25,
    "lineHeight": 1.55,
    "measureCh": 70
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 14
  },
  "stroke": {
    "hairline": 1,
    "icon": 3.4
  },
  "motion": {
    "fadeMs": 220,
    "tickMs": 160,
    "rule": "fade on reveal and a tick on a completed item only; nothing loops; none at all under prefers-reduced-motion"
  }
}
